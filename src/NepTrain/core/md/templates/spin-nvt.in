clear
units metal
atom_style {{ atom_style }}
boundary p p p
{{ plugin_command }}
read_data {{ structure_file }}

pair_style {{ pair_style }}
pair_coeff * * {{ model_file }} {{ elements }}

timestep {{ timestep }}
velocity all create {{ temperature }} 12345 mom yes rot yes dist gaussian
compute spin all property/atom sp spx spy spz fmx fmy fmz fx fy fz
fix integrator all dynspin/glsd/nvt{{ fix_suffix }} temp {{ temperature }} {{ temperature }} {{ tdamp }} dynspin alpha {{ spin_alpha }} stemp {{ spin_temperature }} seed {{ spin_seed }} fm_units field lattice on midpoint_iter {{ midpoint_iter }}

thermo {{ dump_interval }}
thermo_style custom step temp pe ke etotal press
dump trajectory all custom {{ dump_interval }} {{ trajectory_file }} id type x y z c_spin[1] c_spin[2] c_spin[3] c_spin[4] c_spin[5] c_spin[6] c_spin[7]
dump_modify trajectory sort id format float %.17g
run {{ steps }}
