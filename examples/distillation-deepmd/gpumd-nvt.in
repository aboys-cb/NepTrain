# NepTrain template; run through project.yaml, not directly with GPUMD.
# Short interface check, not an equilibrated trajectory.
# https://gpumd.org/gpumd/input_parameters/ensemble_standard.html
potential {{ model_file }}
velocity {{ temperature }} seed {{ seed }}
ensemble nvt_nhc {{ temperature }} {{ temperature }} 100
time_step 0.1
dump_exyz 1 0 1
run {{ steps }}
